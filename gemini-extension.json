{
  "name": "supercatch",
  "version": "1.0.2",
  "description": "Search SuperCatch cards, prices, stores, and docs; account reads require separate OAuth consent.",
  "mcpServers": {
    "supercatch": {
      "httpUrl": "https://supercatch.com/api/mcp",
      "oauth": {
        "enabled": true,
        "scopes": ["account:read", "store:read", "docs:read"]
      },
      "includeTools": [
        "search_marketplace",
        "get_product",
        "get_storefront",
        "get_help_resource",
        "search_public_docs",
        "get_api_catalog",
        "search_account_docs",
        "list_account_orders",
        "list_account_watchlist",
        "list_store_listings",
        "get_store_inventory",
        "list_store_orders"
      ]
    }
  }
}
